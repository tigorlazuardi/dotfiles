#!/bin/bash
# Ensure the podman machine is running. Self-heals after crash/sleep/reboot.
# Invoked by com.user.podman-machine-start LaunchAgent (RunAtLoad + StartInterval).
export PATH="{{ if eq .chezmoi.arch "arm64" }}/opt/homebrew{{ else }}/usr/local{{ end }}/bin:/usr/bin:/bin:/usr/sbin:/sbin"

MACHINE="podman-machine-default"

state="$(podman machine inspect "$MACHINE" --format '{{ "{{.State}}" }}' 2>/dev/null)"

if [ "$state" = "running" ]; then
    exit 0
fi

echo "$(date '+%Y-%m-%dT%H:%M:%S') machine state='${state:-unknown}', starting..."
podman machine start "$MACHINE"
