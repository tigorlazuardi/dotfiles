#!/bin/bash
# Login health checker for Podman on macOS.
# Invoked by com.user.podman-machine-start LaunchAgent (RunAtLoad).
# Keeps retrying until `podman ps` proves the API socket is usable, then exits.
export PATH="{{ if eq .chezmoi.arch "arm64" }}/opt/homebrew{{ else }}/usr/local{{ end }}/bin:/usr/bin:/bin:/usr/sbin:/sbin"

MACHINE="${PODMAN_MACHINE:-podman-machine-default}"
INTERVAL_SECONDS="${PODMAN_HEALTHCHECK_INTERVAL_SECONDS:-5}"

log() {
    echo "$(date '+%Y-%m-%dT%H:%M:%S') $*"
}

attempt=1

while true; do
    ps_output="$(podman ps 2>&1)"
    ps_status=$?

    if [ "$ps_status" -eq 0 ]; then
        log "podman ps succeeded after ${attempt} attempt(s); exiting"
        exit 0
    fi

    state="$(podman machine inspect "$MACHINE" --format '{{ "{{.State}}" }}' 2>/dev/null || true)"
    log "podman ps failed on attempt ${attempt} (state='${state:-unknown}', exit=${ps_status}); ensuring machine is started"
    echo "$ps_output" | sed 's/^/  /'

    podman machine start "$MACHINE" || true

    attempt=$((attempt + 1))
    sleep "$INTERVAL_SECONDS"
done
