# ============================================================
# Ghostty config
# Docs: https://ghostty.org/docs/config/reference
# ============================================================

# --- Font ---
# JetBrains Mono Nerd Font sudah include semua icon (Nerd Font, Powerline,
# Material, Codicons, dll) — gak perlu fallback terpisah.
font-family = JetBrainsMono Nerd Font Mono
font-size = 12
font-feature = -calt, -liga, -dlig    # disable ligatures, hapus baris ini kalau mau ligatures
font-thicken = true
adjust-cell-height = 10%

# --- Theme & warna ---
theme = Catppuccin Mocha
background-opacity = 0.95
background-blur = true
unfocused-split-opacity = 0.7

# --- Window & padding ---
window-padding-x = 10
window-padding-y = 10
window-padding-balance = true
window-decoration = true
window-save-state = always
window-inherit-working-directory = true
window-inherit-font-size = true
confirm-close-surface = false
quit-after-last-window-closed = true

# --- Cursor & mouse ---
cursor-style = block
cursor-style-blink = false
cursor-click-to-move = true
mouse-hide-while-typing = true

# --- Clipboard ---
copy-on-select = clipboard
clipboard-read = allow
clipboard-write = allow
clipboard-paste-protection = true
clipboard-trim-trailing-spaces = true

# --- Scrollback ---
scrollback-limit = 100000

# --- SSH integration ---
# ssh-env: kirim TERM & COLORTERM ke remote host
# ssh-terminfo: auto-install xterm-ghostty terminfo di remote saat pertama connect
shell-integration = detect
shell-integration-features = ssh-env,ssh-terminfo

# ============================================================
# Agent harness support (Claude Code, aider, dll)
# ============================================================
# Shift+Enter -> newline literal (multi-line input di Claude Code prompt)
keybind = shift+enter=text:\n
# Alt+Enter alternatif (beberapa harness pakai ini)
keybind = alt+enter=text:\n

# ============================================================
# Keybindings — prefix ctrl+a (tmux-style)
# ============================================================

# --- Splits ---
keybind = ctrl+a>enter=new_split:right
keybind = ctrl+a>backspace=new_split:down

# --- Move antar pane (vim-style) ---
keybind = ctrl+a>h=goto_split:left
keybind = ctrl+a>j=goto_split:down
keybind = ctrl+a>k=goto_split:up
keybind = ctrl+a>l=goto_split:right

# --- Resize pane ---
# Direct binding (tanpa prefix) supaya bisa di-spam tanpa ulang ctrl+a
keybind = ctrl+alt+h=resize_split:left,10
keybind = ctrl+alt+j=resize_split:down,10
keybind = ctrl+alt+k=resize_split:up,10
keybind = ctrl+alt+l=resize_split:right,10
keybind = ctrl+a>equal=equalize_splits

# --- Zoom / fokus pane ---
keybind = ctrl+a>z=toggle_split_zoom

# --- Tabs ---
keybind = ctrl+a>t=new_tab
keybind = ctrl+a>w=close_tab
keybind = ctrl+a>x=close_surface

# --- Pilih tab langsung 1-9 ---
keybind = ctrl+a>one=goto_tab:1
keybind = ctrl+a>two=goto_tab:2
keybind = ctrl+a>three=goto_tab:3
keybind = ctrl+a>four=goto_tab:4
keybind = ctrl+a>five=goto_tab:5
keybind = ctrl+a>six=goto_tab:6
keybind = ctrl+a>seven=goto_tab:7
keybind = ctrl+a>eight=goto_tab:8
keybind = ctrl+a>nine=goto_tab:9

# --- Misc ---
keybind = ctrl+a>r=reload_config
keybind = ctrl+a>f=toggle_fullscreen
keybind = ctrl+a>c=clear_screen
keybind = ctrl+shift+c=copy_to_clipboard
keybind = ctrl+shift+v=paste_from_clipboard

# --- Kirim literal ctrl+a ke shell (tekan ctrl+a 2x) ---
keybind = ctrl+a>ctrl+a=text:\x01

{{ if eq .chezmoi.os "darwin" -}}
# ============================================================
# macOS-specific
# ============================================================

# Option key sebagai Alt (penting buat readline/fish binding seperti alt+b/f/d)
# Default macOS option = special characters (∂, ∑, dll), bukan alt.
macos-option-as-alt = true

# Titlebar transparent — visual integration dengan window background + blur
macos-titlebar-style = transparent

# Secure Keyboard Entry auto-enable saat password prompt (sudo, ssh, dll)
# Mencegah keylogger lain di sistem baca input password.
macos-auto-secure-input = true
macos-secure-input-indication = true

# Window shadow native
macos-window-shadow = true

# Native macOS fullscreen (animate ke Spaces).
# false = instant fullscreen tanpa animasi (lebih cepat, gak bikin space baru).
macos-non-native-fullscreen = true

# Display P3 wide gamut (warna lebih akurat di MacBook/Studio Display)
window-colorspace = display-p3

# --- Quick Terminal (drop-down dari atas, ala Guake/iTerm hotkey) ---
quick-terminal-position = top
quick-terminal-animation-duration = 0.15
quick-terminal-screen = main
keybind = global:cmd+grave_accent=toggle_quick_terminal

# --- Native cmd+ shortcuts (macOS muscle memory) ---
keybind = cmd+t=new_tab
keybind = cmd+w=close_surface
keybind = cmd+shift+w=close_window
keybind = cmd+n=new_window
keybind = cmd+d=new_split:right
keybind = cmd+shift+d=new_split:down
keybind = cmd+enter=toggle_fullscreen
keybind = cmd+k=clear_screen
keybind = cmd+r=reload_config

# --- Cmd-1..9 untuk tab switch (native macOS) ---
keybind = cmd+one=goto_tab:1
keybind = cmd+two=goto_tab:2
keybind = cmd+three=goto_tab:3
keybind = cmd+four=goto_tab:4
keybind = cmd+five=goto_tab:5
keybind = cmd+six=goto_tab:6
keybind = cmd+seven=goto_tab:7
keybind = cmd+eight=goto_tab:8
keybind = cmd+nine=goto_tab:9

# --- Cmd+shift+[ / ] untuk navigasi tab (native macOS) ---
keybind = cmd+shift+left_bracket=previous_tab
keybind = cmd+shift+right_bracket=next_tab
{{ end -}}
