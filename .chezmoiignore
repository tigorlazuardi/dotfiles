# ============================================================
# .chezmoiignore — file/pattern yang TIDAK boleh di-track oleh chezmoi
# Pattern relative ke $HOME, gitignore-style
# Berlaku saat `chezmoi add` (skip) DAN `chezmoi apply` (gak touch target)
# ============================================================

# --- fish ---
.config/fish/fish_variables            # machine-specific universal vars
.config/fish/fish_history              # local history
.config/fish/completions/**            # auto-downloaded completions (kalau ada)

# --- lazygit ---
.config/lazygit/state.yml              # runtime state, auto-generated
.config/lazygit/*.log                  # error logs

# --- ghostty ---
.config/ghostty/themes/**              # local custom themes (opsional, hapus pattern ini kalau mau di-track)

# --- chezmoi sendiri ---
.config/chezmoi/chezmoi.toml.tmpl      # template-only, gak perlu di-track sebagai-is
README.md                              # repo readme, bukan dotfile target
LICENSE                                # repo license, bukan dotfile target

# --- system / cache yang nyasar ---
.config/**/*.lock
.config/**/cache/**
.config/**/Cache/**
.config/**/.cache/**
.config/**/logs/**
.config/**/*.log

# --- claude code ---
# Only track: commands/, agents/, skills/, hooks/, settings.json, plugins/*.json
.claude/backups/**
.claude/cache/**
.claude/debug/**
.claude/file-history/**
.claude/paste-cache/**
.claude/plans/**
.claude/projects/**
.claude/session-env/**
.claude/sessions/**
.claude/shell-snapshots/**
.claude/statsig/**
.claude/tasks/**
.claude/telemetry/**
.claude/todos/**
.claude/history.jsonl
.claude/*.bak
.claude/.caveman-active
.claude/.last-cleanup
.claude/stats-cache.json
.claude/mcp-needs-auth-cache.json
.claude/plugins/cache/**
.claude/plugins/marketplaces/**
.claude/plugins/data/**
.claude/plugins/install-counts-cache.json
# machine-specific runtime cache: contains absolute installPath + timestamps, regenerated per-machine
.claude/plugins/installed_plugins.json
.claude/plugins/known_marketplaces.json
.claude/handovers/**
.claude/scratch/**
.claude/agent-memory/**

# --- security ---
# Pastiin secret gak nyasar ke-add (defense-in-depth, gitleaks juga akan reject)
.config/**/credentials*
.config/**/secrets*
.config/**/*.key
.config/**/*.pem
.npmrc-personal
.envrc                                 # per-direktori env, jangan track global
.envrc.local

# ============================================================
# nixos server — sync HANYA config Claude Code
# ============================================================
# Di NixOS, cuma ~/.claude/** + script reinstall plugin Claude yang
# di-sync. Semua dotfile lain di-exclude.
# Catatan chezmoi: exclude SELALU menang atas include (!pattern), jadi
# whitelist via ! mustahil — harus enumerate tiap target non-claude.
# Nested if: cek os==linux dulu, baru osRelease.id (darwin gak punya key 'id').
{{ if eq .chezmoi.os "linux" -}}
{{ if eq .chezmoi.osRelease.id "nixos" -}}
.config
.config/**
.gitconfig
.npmrc
.git-template
.git-template/**
.chezmoiscripts/install-packages.sh
{{ end -}}
{{ end -}}
