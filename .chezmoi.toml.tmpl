{{/* ============================================================
     chezmoi.toml.tmpl
     Template untuk ~/.config/chezmoi/chezmoi.toml
     Dirender saat `chezmoi init`. Edit di sini, JANGAN edit output-nya.
     ============================================================ */ -}}

{{- $name      := promptStringOnce . "name"      "Nama lengkap (untuk git)" "Tigor Hutasuhut" -}}
{{- $email     := promptStringOnce . "email"     "Email (untuk git)"        "tigor.hutasuhut@gmail.com" -}}
{{- $ageId     := promptStringOnce . "ageId"     "Path ke age identity (private key)" (joinPath .chezmoi.homeDir ".config/chezmoi/key.txt") -}}
{{- $ageRecipient := promptStringOnce . "ageRecipient" "Age recipient (public key, age1...)" "age1tjtug6ja4pdadescfw0kkyvrn96dy6325v5p6gxx4g7z2d9cxqgs899653" -}}

# --- Encryption (age) ---
# Encrypt secrets via `chezmoi add --encrypt <file>`.
# Identity (private key) JANGAN di-commit — pastikan path di luar source dir + di-backup offline.
# Recipient (public key) aman ke-commit, dipakai untuk enkripsi.
encryption = "age"

[data]
name  = {{ $name | quote }}
email = {{ $email | quote }}

[git]
# Auto-commit setelah `chezmoi add` / `re-add`
autoCommit = true
# Auto-push setelah auto-commit
autoPush = true
# Commit message: pakai default chezmoi (auto-generate per file: "Add X", "Update Y", dll)

[age]
identity  = {{ $ageId | quote }}
recipient = {{ $ageRecipient | quote }}

[edit]
# Editor untuk `chezmoi edit`. Fallback ke $EDITOR/$VISUAL kalau ini gak di-set.
command = "nvim"
