# pi-web environment — copy to ~/.config/pi-web.env on the VPS, then `chmod 600`.
# Loaded by the systemd user units via EnvironmentFile.

# Bind the web server to LOCALHOST ONLY. pi-web has NO auth of its own
# ("assumes trusted users; not a sandbox"). Never bind to the VPN IP directly —
# put Caddy/nginx (TLS + basic-auth) in front and proxy to this localhost port.
PI_WEB_HOST=127.0.0.1
PI_WEB_PORT=8504

# Anti DNS-rebind: only accept requests whose Host header matches these.
# Set to the hostname Caddy proxies as (comma-separated). Adjust to your VPS host.
PI_WEB_ALLOWED_HOSTS=pi.internal,localhost,127.0.0.1

# Where pi-web keeps its state (sessions, projects). Keep on persistent disk.
PI_WEB_DATA_DIR=%h/.local/share/pi-web

# Sessiond <-> server wiring. The launcher defaults usually suffice; if you split
# the processes, point the server at the daemon explicitly (uncomment + verify the
# var name against `pi-web --help` for your installed version):
# PI_WEB_SESSIOND_SOCKET=%h/.local/share/pi-web/sessiond.sock
# PI_WEB_SESSIOND_URL=http://127.0.0.1:8505

PI_WEB_SKIP_VERSION_CHECK=1
