{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pi.local/schemas/fleet/state.schema.json",
  "title": "state.json",
  "description": "Owner: orchestrator. 1 file = 1 DAG = 1 spec. nodes[] = task per ticket. dependsOn[] is the sole edge source. See docs/design/2026-07-12-fleet-revamp.mdx §State — fleet.json & state.json.",
  "type": "object",
  "required": ["meta", "tracker", "nodes", "stopFlag"],
  "properties": {
    "meta": {
      "type": "object",
      "required": ["runName", "schemaVersion", "specRef", "standardsRef", "baseBranch", "integrationBranch"],
      "properties": {
        "runName": { "type": "string", "minLength": 1 },
        "schemaVersion": { "type": "integer", "minimum": 1 },
        "specRef": { "type": "string", "minLength": 1 },
        "standardsRef": { "type": "string", "minLength": 1, "description": "CODING_STANDARDS.md pointer, injected into every worker/reviewer spawn" },
        "baseBranch": { "type": "string", "minLength": 1 },
        "integrationBranch": {
          "type": "string",
          "pattern": "^fleet/[^/]+/int$",
          "description": "fleet/<run>/int"
        }
      }
    },
    "tracker": {
      "type": "object",
      "required": ["type", "supportsBlocking"],
      "properties": {
        "type": { "type": "string", "description": "local-md | github | linear | pi-tasks | ... (open set, mirror is one-way state -> tracker)" },
        "supportsBlocking": { "type": "boolean" }
      }
    },
    "nodes": {
      "type": "array",
      "items": { "$ref": "#/$defs/node" }
    },
    "stopFlag": { "$ref": "#/$defs/stopFlag" }
  },
  "$defs": {
    "node": {
      "type": "object",
      "required": ["id", "ticket", "dependsOn", "routing", "runtime", "sync", "attributes", "audit"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "ticket": {
          "type": "object",
          "required": ["ref", "title"],
          "properties": {
            "ref": { "type": "string", "minLength": 1 },
            "title": { "type": "string" },
            "contentCache": { "type": "string", "description": "optional — external tracker only" }
          }
        },
        "dependsOn": {
          "type": "array",
          "items": { "type": "string" },
          "description": "the sole source of edges"
        },
        "routing": {
          "type": "object",
          "required": ["failureTolerance", "worker", "reviewer", "checkCommand"],
          "properties": {
            "failureTolerance": { "enum": ["low", "standard", "trivial"] },
            "worker": { "enum": ["worker", "frontier"], "description": "CLASS, not a concrete agent name — resolved to a concrete agent (e.g. claude-worker/codex-worker) at spawn time via the matching agent listing's frontmatter `class:` field. Never downgraded (safety-ratchet); provider may change on failover." },
            "reviewer": { "enum": ["worker", "frontier"], "description": "CLASS, same resolution rule as routing.worker. Reviewer identity != producer is guaranteed by the fresh-spawn-per-axis protocol, not by this field differing from routing.worker." },
            "checkCommand": { "type": "string", "minLength": 1, "description": "executable truth-signal, reviewer MUST run" }
          }
        },
        "runtime": {
          "type": "object",
          "required": ["status", "fixAttempt", "handoverAttempt", "branch", "commitSha", "acceptanceResult", "agentId"],
          "properties": {
            "status": { "enum": ["pending", "running", "review", "fixing", "passed", "failed"] },
            "fixAttempt": { "type": "integer", "minimum": 0, "maximum": 3 },
            "handoverAttempt": { "type": "integer", "minimum": 0, "maximum": 3 },
            "branch": {
              "type": "string",
              "pattern": "^fleet/[^/]+/task/[^/]+/[^/]+$",
              "description": "fleet/<run>/task/<dagId>/<taskId>"
            },
            "commitSha": { "type": ["string", "null"] },
            "acceptanceResult": { "enum": [null, "pass", "fail"] },
            "agentId": { "type": ["string", "null"] }
          }
        },
        "sync": {
          "type": "object",
          "required": ["mirrored", "pushed"],
          "properties": {
            "mirrored": { "type": "boolean" },
            "pushed": { "type": "boolean", "description": "push is part of the verdict transaction; state must never point at a sha absent from remote" }
          }
        },
        "attributes": {
          "type": "object",
          "additionalProperties": { "type": "string" }
        },
        "audit": {
          "type": "array",
          "items": { "$ref": "#/$defs/auditSpan" }
        }
      }
    },
    "auditSpan": {
      "description": "OTel-span-shaped, 1 entry per spawn. Shared shape — duplicated verbatim from fleet.schema.json for offline $ref-free validation.",
      "type": "object",
      "required": ["role", "agentType", "model", "agentId", "startedAt", "endedAt", "status", "error", "summary", "attributes"],
      "properties": {
        "role": { "enum": ["worker", "reviewer", "judge", "orchestrator", "steering"] },
        "agentType": { "type": "string", "description": "pointer tier, e.g. claude-worker (intent)" },
        "model": { "type": "string", "description": "resolved model, e.g. claude-sonnet-5 (fact)" },
        "agentId": { "type": "string" },
        "startedAt": { "type": "string", "format": "date-time" },
        "endedAt": { "type": ["string", "null"], "format": "date-time" },
        "status": { "enum": ["ok", "error"] },
        "error": { "type": ["string", "null"], "description": "verbatim, first-class; invariant: error != null <=> status:error" },
        "summary": { "type": "string" },
        "attributes": { "type": "object", "additionalProperties": { "type": "string" } },
        "reportRef": { "type": "string", "description": "optional pointer to long-form report" }
      },
      "allOf": [
        {
          "if": { "properties": { "status": { "const": "error" } }, "required": ["status"] },
          "then": { "required": ["error"], "properties": { "error": { "type": "string", "minLength": 1 } } }
        },
        {
          "if": { "properties": { "status": { "const": "ok" } }, "required": ["status"] },
          "then": { "properties": { "error": { "type": "null" } } }
        }
      ]
    },
    "stopFlag": {
      "type": "object",
      "required": ["stopped", "reason", "stoppedAt"],
      "properties": {
        "stopped": { "type": "boolean" },
        "reason": { "type": ["string", "null"] },
        "stoppedAt": { "type": ["string", "null"], "format": "date-time" }
      }
    }
  }
}
