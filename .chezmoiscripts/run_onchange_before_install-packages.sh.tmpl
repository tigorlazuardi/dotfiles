#!/usr/bin/env bash
# ============================================================
# Install dependencies. OS-dispatch via Go template.
# Run by chezmoi before apply when this file's rendered output changes.
# Idempotent — safe to re-run.
# ============================================================
set -euo pipefail

log()  { printf "\033[1;34m[install]\033[0m %s\n" "$*"; }
warn() { printf "\033[1;33m[warn]\033[0m %s\n" "$*"; }

{{ if eq .chezmoi.os "darwin" -}}
# ============================================================
# macOS — Homebrew
# ============================================================
if ! command -v brew >/dev/null 2>&1; then
  log "Homebrew tidak terinstal. Install dulu:"
  echo '    /bin/bash -c "$(curl -fsSL https://raw.githubusercontent.com/Homebrew/install/HEAD/install.sh)"'
  exit 1
fi

# --- Formulae ---
BREW_FORMULAE=(
  fish
  ghostty
  lazygit
  git-delta        # `delta` binary
  gh
  gitleaks
  pre-commit
  eza
  bat
  fd
  ripgrep
  fzf
  jq
  onefetch
  tuxedo           # keyboard-driven todo.txt TUI
  zoxide
  direnv
  mise             # per-project tool versions (mise.toml)
  usage            # mise completions spec backend
  node             # nodejs + npm
  pnpm             # langsung dari brew, skip corepack (lihat install script comment)
  neovim           # default $EDITOR
  age              # encryption untuk chezmoi secret

  # --- nvim ecosystem (LSP/formatter/linter) ---
  # LazyVim extras: go, typescript+biome, prettier, docker, markdown, sql, toml, sops.
  # LSP lain (json, yaml, svelte, astro, tailwind, dll) di-handle mason on-demand.
  go               # toolchain Go (gopls + gofmt bundled in)
  gopls            # Go LSP (eksplisit, biar gak depend on `go install`)
  gofumpt          # Go formatter (stricter dari gofmt)
  golangci-lint    # Go linter aggregator
  delve            # Go debugger (dlv)
  biome            # TS/JS LSP + formatter + linter
  prettier         # formatter (markdown, json, css, dll)
  stylua           # Lua formatter (config exists: nvim/stylua.toml)
  selene           # Lua linter (config exists: nvim/selene.toml)
  shellcheck       # shell linter
  shfmt            # shell formatter
  hadolint         # Dockerfile linter
  marksman         # Markdown LSP
  taplo            # TOML formatter + LSP
  sqlfluff         # SQL linter + formatter
  lua-language-server  # Lua LSP (untuk nvim config sendiri via lazydev)
  sops             # secret editor (plugin nvim-sops)
)
# Catatan: corepack tidak dipakai karena konflik binary dengan brew pnpm.
# Konsekuensi: pnpm version fixed via brew, gak per-project (gak baca packageManager field).

log "Installing brew formulae (idempotent)..."
brew install "${BREW_FORMULAE[@]}"

# --- Casks (font) ---
log "Installing JetBrains Mono Nerd Font cask..."
brew install --cask font-jetbrains-mono-nerd-font

# --- gh extensions (gh-dash gak ada di brew core) ---
if command -v gh >/dev/null 2>&1; then
  if ! gh extension list 2>/dev/null | grep -q "dlvhdr/gh-dash"; then
    log "Installing gh-dash as gh extension..."
    gh extension install dlvhdr/gh-dash || warn "gh-dash install failed (mungkin butuh gh auth login dulu)"
  fi
fi

# --- glint (Conventional Commits, dipakai lazygit `Z`) ---
# Gak ada di brew core. Install via cargo kalau cargo ada, kalau gak skip.
if ! command -v glint >/dev/null 2>&1; then
  if command -v cargo >/dev/null 2>&1; then
    log "Installing glint via cargo..."
    cargo install glint || warn "glint install failed"
  else
    warn "glint skipped — install rust+cargo lalu 'cargo install glint', atau ganti lazygit Z keybind"
  fi
fi

# --- fish sebagai shell (info only, gak ganti otomatis) ---
FISH_PATH="$(command -v fish)"
if [ -n "$FISH_PATH" ]; then
  if ! grep -qxF "$FISH_PATH" /etc/shells; then
    log "Menambahkan $FISH_PATH ke /etc/shells (butuh sudo)..."
    echo "$FISH_PATH" | sudo tee -a /etc/shells >/dev/null
  fi
  if [ "${SHELL:-}" != "$FISH_PATH" ]; then
    warn "Default shell belum fish. Jalanin manual: chsh -s $FISH_PATH"
  fi
fi

log "macOS install done."

{{ else if eq .chezmoi.os "linux" -}}
# ============================================================
# Linux — Arch (sesuai README repo)
# ============================================================
{{   if eq .chezmoi.osRelease.id "arch" -}}
log "Arch Linux detected."

# --- Bootstrap dependencies untuk build AUR ---
# base-devel = gcc, make, fakeroot, dll (butuh untuk makepkg)
# git = clone AUR repos
log "Installing base-devel + git (untuk build AUR)..."
sudo pacman -S --needed --noconfirm base-devel git

# --- Install yay kalau belum ada ---
# yay-bin = precompiled binary (cepat), bukan yay (compile dari source)
if ! command -v yay >/dev/null 2>&1; then
  log "yay tidak ada — bootstrap dari AUR via makepkg..."
  TMPDIR=$(mktemp -d)
  trap 'rm -rf "$TMPDIR"' EXIT
  git clone --depth=1 https://aur.archlinux.org/yay-bin.git "$TMPDIR/yay-bin"
  (cd "$TMPDIR/yay-bin" && makepkg -si --noconfirm)
  log "yay installed: $(yay --version | head -1)"
else
  log "yay sudah ada: $(yay --version | head -1)"
fi

# --- AUR packages via yay ---
# yay -S idempotent (--needed skip kalau sudah terinstall).
# Pakai --noconfirm + --answerdiff=None biar gak prompt PKGBUILD diff (CI-friendly).
log "Installing AUR packages..."
yay -S --needed --noconfirm --answerdiff=None --answerclean=None \
  fish ghostty chezmoi nodejs npm pnpm \
  lazygit git-delta gh gh-dash gitleaks pre-commit \
  eza bat fd ripgrep fzf jq onefetch tuxedo-bin \
  zoxide direnv mise usage wl-clipboard ttf-jetbrains-mono-nerd \
  neovim age \
  `# --- nvim ecosystem (LSP/formatter/linter) ---` \
  go gopls go-tools delve golangci-lint \
  biome prettier \
  stylua lua-language-server \
  shellcheck-bin shfmt \
  taplo-cli \
  sops \
  glint \
  claude-code \
  gofumpt \
  selene \
  hadolint-bin \
  marksman-bin \
  sqlfluff \
  || warn "Beberapa AUR package gagal install. Cek output di atas."

{{   else -}}
warn "Linux distro {{ .chezmoi.osRelease.id }} belum di-handle. Install manual."
exit 0
{{   end -}}

{{ else -}}
warn "OS {{ .chezmoi.os }} belum di-handle."
exit 0
{{ end -}}
# Catatan: fisher update sengaja tidak dijalankan.
# Repo sudah vendor plugin files (fzf.fish, autopair, done, plugin-bang-bang) ke
# functions/ dan conf.d/. Jalanin `fisher update` bakal konflik dengan file managed.
