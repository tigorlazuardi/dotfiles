#!/bin/sh
# Re-install Claude Code plugins declared in ~/.claude/settings.json.
# Runs on chezmoi apply when the settings template changes.
#
# Hash trigger (forces re-run when content changes):
# settings: {{ include "dot_claude/private_settings.json" | sha256sum }}

set -eu

# VPS rootless: claude + jq datang dari mise shims. No-op di macOS/Arch/NixOS.
export PATH="$HOME/.local/share/mise/shims:$HOME/.local/bin:$PATH"

CLAUDE_DIR="${CLAUDE_CONFIG_DIR:-$HOME/.claude}"
SETTINGS="$CLAUDE_DIR/settings.json"

if ! command -v claude >/dev/null 2>&1; then
  echo "[claude-plugins] claude CLI not found in PATH, skipping plugin bootstrap"
  exit 0
fi

if ! command -v jq >/dev/null 2>&1; then
  echo "[claude-plugins] jq not found, skipping plugin bootstrap"
  exit 0
fi

if [ ! -f "$SETTINGS" ]; then
  echo "[claude-plugins] $SETTINGS not found, nothing to do"
  exit 0
fi

echo "[claude-plugins] registering marketplaces…"
jq -r '(.extraKnownMarketplaces // {}) | to_entries[] | "\(.key)\t\(.value.source.repo // .value.source.url // .value.source.path // "")"' "$SETTINGS" \
| while IFS="$(printf '\t')" read -r name source; do
    [ -z "$source" ] && continue
    if claude plugin marketplace list 2>/dev/null | grep -q "^$name\b"; then
      echo "  • $name already registered"
    else
      echo "  • adding $name ($source)"
      claude plugin marketplace add "$source" --scope user || true
    fi
  done

echo "[claude-plugins] installing plugins…"
jq -r '(.enabledPlugins // {}) | to_entries[] | select(.value == true) | .key' "$SETTINGS" \
| while read -r plugin; do
    [ -z "$plugin" ] && continue
    if claude plugin list 2>/dev/null | grep -q "^$plugin\b"; then
      echo "  • $plugin already installed"
    else
      echo "  • installing $plugin"
      claude plugin install "$plugin" --scope user || true
    fi
  done

echo "[claude-plugins] done"
