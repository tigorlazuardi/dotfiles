#!/bin/sh
# Re-install Claude Code plugins listed in ~/.claude/plugins/installed_plugins.json
# Runs on chezmoi apply when the source JSON files change.
#
# Hash trigger (forces re-run when content changes):
# installed_plugins.json: {{ include "dot_claude/plugins/installed_plugins.json" | sha256sum }}
# known_marketplaces.json: {{ include "dot_claude/plugins/known_marketplaces.json" | sha256sum }}

set -eu

if ! command -v claude >/dev/null 2>&1; then
  echo "[claude-plugins] claude CLI not found in PATH, skipping plugin bootstrap"
  exit 0
fi

if ! command -v jq >/dev/null 2>&1; then
  echo "[claude-plugins] jq not found, skipping plugin bootstrap"
  exit 0
fi

MARKETPLACES="$HOME/.claude/plugins/known_marketplaces.json"
INSTALLED="$HOME/.claude/plugins/installed_plugins.json"

if [ ! -f "$MARKETPLACES" ] || [ ! -f "$INSTALLED" ]; then
  echo "[claude-plugins] metadata files missing, nothing to do"
  exit 0
fi

echo "[claude-plugins] registering marketplaces…"
jq -r 'to_entries[] | "\(.key)\t\(.value.source.repo // .value.source.url // .value.source.path)"' "$MARKETPLACES" \
| while IFS="$(printf '\t')" read -r name source; do
    [ -z "$source" ] && continue
    if claude plugin marketplace list 2>/dev/null | grep -q "^$name\b"; then
      echo "  • $name already registered"
    else
      echo "  • adding $name ($source)"
      claude plugin marketplace add "$source" --scope user || true
    fi
  done

echo "[claude-plugins] installing plugins…"
jq -r '.plugins | keys[]' "$INSTALLED" \
| while read -r plugin; do
    [ -z "$plugin" ] && continue
    if claude plugin list 2>/dev/null | grep -q "^$plugin\b"; then
      echo "  • $plugin already installed"
    else
      echo "  • installing $plugin"
      claude plugin install "$plugin" --scope user || true
    fi
  done

echo "[claude-plugins] done"
