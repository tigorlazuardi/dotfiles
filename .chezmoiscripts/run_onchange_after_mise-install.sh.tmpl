{{ if and (eq .chezmoi.os "linux") (and (ne .chezmoi.osRelease.id "arch") (ne .chezmoi.osRelease.id "nixos")) -}}
#!/usr/bin/env bash
# ============================================================
# Install global tools declared di ~/.config/mise/config.toml.
# Generic Linux (VPS rootless) ONLY — macOS pakai brew, Arch
# pakai yay, NixOS pakai nix (branch ini gak ke-render di sana).
# Jalan setelah apply, saat config.toml berubah. Idempotent.
#
# Hash trigger:
# mise config: {{ include "dot_config/mise/config.toml" | sha256sum }}
# ============================================================
set -euo pipefail

log()  { printf "\033[1;34m[mise]\033[0m %s\n" "$*"; }
warn() { printf "\033[1;33m[warn]\033[0m %s\n" "$*"; }

export PATH="$HOME/.local/bin:$PATH"

if ! command -v mise >/dev/null 2>&1; then
  warn "mise tidak ditemukan — bootstrap harusnya jalan di install-packages. Skip."
  exit 0
fi

log "mise install (rootless, dari ~/.config/mise/config.toml)..."
mise install --yes || warn "Sebagian tool gagal install. Cek output di atas."
mise reshim
log "done. Tools di ~/.local/share/mise, shims di ~/.local/share/mise/shims"
{{ else -}}
#!/usr/bin/env bash
# macOS/Arch/NixOS: tools dikelola brew/yay/nix. No-op.
exit 0
{{ end -}}
